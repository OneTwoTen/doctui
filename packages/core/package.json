{
  "name": "@doctui/core",
  "version": "0.0.0",
  "description": "Core Vue components and theme primitives for doctui.",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/public-index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/public-index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{ recursive: true, force: true })\"",
    "build:js": "bun run --bun vite build",
    "build:types": "node ../../scripts/vue-tsc.mjs -p tsconfig.build.json",
    "build": "bun run clean && bun run build:js && bun run build:types"
  },
  "peerDependencies": {
    "vue": ">=3.5.0 <4"
  }
}
